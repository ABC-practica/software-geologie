<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.abc.controller.ObjectTransformController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label fx:id="selectedObjectLabel"
           text="No object selected"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Position X:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="positionX"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>


        <Label text="Position Y:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="positionY"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>


        <Label text="Position Z:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="positionZ"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <Label text="Rotation X:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="rotationX"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>


        <Label text="Rotation Y:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="rotationY"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>


        <Label text="Rotation Z:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <TextField fx:id="rotationZ"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="5"/>

    </GridPane>

    <Button text="Apply"
            maxWidth="Infinity"
            onAction="#handleApply"/>

    <Button text="Reset"
            maxWidth="Infinity"
            onAction="#handleReset"/>

</VBox>